{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "t0": "T0_ONLY=1 node server.js",
    "dev:server": "node --watch --env-file=.env --import tsx server/index.ts",
    "migrate": "node --env-file=.env server-dist/server/db/migrate.js",
    "seed": "node --env-file=.env server-dist/server/db/seed.js",
    "test": "TSX_TSCONFIG_PATH=tsconfig.app.json node --env-file=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "reset-admin": "node --env-file=.env --import tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.19.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "heic2any": "^0.0.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
