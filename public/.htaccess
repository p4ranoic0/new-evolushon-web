# Hostinger / Apache: publicar el contenido de dist en public_html.
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# URLs anteriores: 301 antes del fallback de la SPA.
RewriteRule ^clases/surf/?$ /es/servicios?category=surf [R=301,L,NE]
RewriteRule ^clases/surfskate/?$ /es/servicios?category=surfskate [R=301,L,NE]
RewriteRule ^surftrips/?$ /es/servicios?category=trip [R=301,L,NE]
RewriteRule ^en/surftrips/?$ /en/services?category=trip [R=301,L,NE]
RewriteRule ^galeria/?$ /es/galeria [R=301,L,NE]
RewriteRule ^contacto/?$ /es/contacto [R=301,L,NE]
RewriteRule ^$ /es/ [R=302,L]

# No reescribir archivos/directorios reales, incluidos /assets y metadatos.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Las rutas soportadas cargan React Router; las desconocidas responden HTTP 404.
# Al publicar nuevos servicios/slugs en los archivos base, actualiza esta lista.
# Conserva la página 404 de React sin convertir el error en un HTTP 200.
ErrorDocument 404 /index.html
RewriteRule ^admin(?:/.*)?$ index.html [L]
RewriteRule ^(?:es|en|fr|de)/?$ index.html [L]
RewriteRule ^es/(?:servicios|galeria|contacto)/?$ index.html [L]
RewriteRule ^es/servicios/(?:s-grupal|s-privada|s-coaching|s-tandem|k-grupal|k-privada|k-coaching|t-punta|t-puerto|t-bermejo)/?$ index.html [L]
RewriteRule ^en/(?:services|gallery|contact)/?$ index.html [L]
RewriteRule ^en/services/(?:s-grupal|s-privada|s-coaching|s-tandem|k-grupal|k-privada|k-coaching|t-punta|t-puerto|t-bermejo)/?$ index.html [L]
RewriteRule ^fr/(?:services|galerie|contact)/?$ index.html [L]
RewriteRule ^fr/services/(?:s-grupal|s-privada|s-coaching|s-tandem|k-grupal|k-privada|k-coaching|t-punta|t-puerto|t-bermejo)/?$ index.html [L]
RewriteRule ^de/(?:angebote|galerie|kontakt)/?$ index.html [L]
RewriteRule ^de/angebote/(?:s-grupal|s-privada|s-coaching|s-tandem|k-grupal|k-privada|k-coaching|t-punta|t-puerto|t-bermejo)/?$ index.html [L]
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite genera nombres con hash; el resto de recursos no recibe immutable.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:js|css|jpg|jpeg|png|webp|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
